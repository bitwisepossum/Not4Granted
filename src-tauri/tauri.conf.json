{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "not4granted",
  "version": "0.1.0",
  "identifier": "com.bitwisepossum.not4granted",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },

  "app": {
    "windows": [
      {
        "title": "not4granted",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "nsis"
    ],

    "shortDescription": "Local grant and manuscript tracker",
    "license": "EUPL-1.2",
    "licenseFile": "../LICENSE.md",

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],

    "linux": {
      "rpm": {
        "release": "1"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },

    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
